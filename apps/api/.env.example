# Copy to apps/api/.env and adjust. The .env file is git-ignored. Never commit real credentials.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Replace USER, PASSWORD and DATABASE with your own values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# Part 2: file upload. Optional, these are the defaults. Relative paths are resolved from apps/api.
# UPLOAD_DIR=storage/uploads
# UPLOAD_TEMP_DIR=storage/tmp
# MAX_UPLOAD_FILE_BYTES=52428800
# MAX_UPLOAD_FILES=5

# Background worker. Optional, these are the defaults (milliseconds).
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_HEARTBEAT_INTERVAL_MS=5000
# WORKER_STALE_AFTER_MS=60000

# Part 1: sign-in. Optional, these are the defaults.
# SESSION_TTL_HOURS=12
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_RATE_LIMIT_MAX=20
# BCRYPT_COST=12

# The two accounts created by `npm run db:seed:users -w @leaklens/api`.
# Choose your own emails and passwords (12 to 72 characters). Never commit the real values.
SEED_EXECUTIVE_EMAIL=executive@example.test
SEED_EXECUTIVE_PASSWORD=change-me-please-123
# SEED_EXECUTIVE_NAME=Demo Executive
SEED_COFOUNDER_EMAIL=cofounder@example.test
SEED_COFOUNDER_PASSWORD=change-me-please-456
# SEED_COFOUNDER_NAME=Demo Co-founder
