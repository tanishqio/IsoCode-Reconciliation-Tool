{
  "name": "leaklens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeakLens - D2C order, payment and return reconciliation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev -w @leaklens/api\" \"npm run dev:worker -w @leaklens/api\" \"npm run dev -w @leaklens/web\"",
    "dev:api": "npm run dev -w @leaklens/api",
    "dev:worker": "npm run dev:worker -w @leaklens/api",
    "worker": "npm run worker -w @leaklens/api",
    "dev:web": "npm run dev -w @leaklens/web",
    "build": "npm run build -w @leaklens/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @leaklens/api",
    "test:docker": "npm run test:docker -w @leaklens/api",
    "test:all": "npm run test:all -w @leaklens/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @leaklens/api",
    "db:seed": "npm run db:seed -w @leaklens/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
